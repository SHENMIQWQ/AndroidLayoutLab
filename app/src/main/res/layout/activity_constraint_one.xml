<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8"
    android:paddingStart="16dp"
    android:paddingTop="24dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/calculator_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/calculator_input"
        android:textColor="#6C6C6C"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/calculator_display"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_calculator_display"
        android:gravity="end|center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="0.0"
        android:textColor="#4C4C4C"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/calculator_label" />

    <Button
        android:id="@+id/calc_7"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_calculator_button"
        android:backgroundTint="@null"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="7"
        android:textColor="#444444"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/calc_8"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/calculator_display" />

    <Button
        android:id="@+id/calc_8"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_calculator_button"
        android:backgroundTint="@null"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="8"
        android:textColor="#444444"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/calc_9"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/calc_7"
        app:layout_constraintTop_toBottomOf="@id/calculator_display" />

    <Button
        android:id="@+id/calc_9"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_calculator_button"
        android:backgroundTint="@null"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="9"
        android:textColor="#444444"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/calc_plus"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/calc_8"
        app:layout_constraintTop_toBottomOf="@id/calculator_display" />

    <Button
        android:id="@+id/calc_plus"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_calculator_button"
        android:backgroundTint="@null"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="+"
        android:textColor="#444444"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/calc_9"
        app:layout_constraintTop_toBottomOf="@id/calculator_display" />

    <Button
        android:id="@+id/calc_4"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_calculator_button"
        android:backgroundTint="@null"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="4"
        android:textColor="#444444"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/calc_5"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/calc_7" />

    <Button
        android:id="@+id/calc_5"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_calculator_button"
        android:backgroundTint="@null"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="5"
        android:textColor="#444444"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/calc_6"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/calc_4"
        app:layout_constraintTop_toBottomOf="@id/calc_8" />

    <Button
        android:id="@+id/calc_6"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_calculator_button"
        android:backgroundTint="@null"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="6"
        android:textColor="#444444"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/calc_multiply"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/calc_5"
        app:layout_constraintTop_toBottomOf="@id/calc_9" />

    <Button
        android:id="@+id/calc_multiply"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_calculator_button"
        android:backgroundTint="@null"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="×"
        android:textColor="#444444"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/calc_6"
        app:layout_constraintTop_toBottomOf="@id/calc_plus" />

    <Button
        android:id="@+id/calc_1"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_calculator_button"
        android:backgroundTint="@null"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="1"
        android:textColor="#444444"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/calc_2"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/calc_4" />

    <Button
        android:id="@+id/calc_2"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_calculator_button"
        android:backgroundTint="@null"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="2"
        android:textColor="#444444"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/calc_3"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/calc_1"
        app:layout_constraintTop_toBottomOf="@id/calc_5" />

    <Button
        android:id="@+id/calc_3"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_calculator_button"
        android:backgroundTint="@null"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="3"
        android:textColor="#444444"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/calc_minus"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/calc_2"
        app:layout_constraintTop_toBottomOf="@id/calc_6" />

    <Button
        android:id="@+id/calc_minus"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_calculator_button"
        android:backgroundTint="@null"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="−"
        android:textColor="#444444"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/calc_3"
        app:layout_constraintTop_toBottomOf="@id/calc_multiply" />

    <Button
        android:id="@+id/calc_dot"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_calculator_button"
        android:backgroundTint="@null"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="."
        android:textColor="#444444"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/calc_0"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/calc_1" />

    <Button
        android:id="@+id/calc_0"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_calculator_button"
        android:backgroundTint="@null"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="0"
        android:textColor="#444444"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/calc_equal"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/calc_dot"
        app:layout_constraintTop_toBottomOf="@id/calc_2" />

    <Button
        android:id="@+id/calc_equal"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_calculator_button"
        android:backgroundTint="@null"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="="
        android:textColor="#444444"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/calc_divide"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/calc_0"
        app:layout_constraintTop_toBottomOf="@id/calc_3" />

    <Button
        android:id="@+id/calc_divide"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_calculator_button"
        android:backgroundTint="@null"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="÷"
        android:textColor="#444444"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/calc_equal"
        app:layout_constraintTop_toBottomOf="@id/calc_minus" />

</androidx.constraintlayout.widget.ConstraintLayout>
