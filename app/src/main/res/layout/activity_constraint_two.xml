<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9F9"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:id="@+id/space_nav"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:background="@drawable/bg_nav_bar"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/space_stations"
                android:scaleType="fitCenter"
                android:src="@drawable/space_station_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/space_stations"
                android:textColor="#68727C"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="36dp"
                android:contentDescription="@string/flights"
                android:scaleType="fitCenter"
                android:src="@drawable/rocket_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/flights"
                android:textColor="#68727C"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:contentDescription="@string/rovers"
                android:scaleType="fitCenter"
                android:src="@drawable/rover_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/rovers"
                android:textColor="#68727C"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/route_bar"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_route_green"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/space_nav">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="DCA"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="双向路线"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/double_arrows"
            android:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="MARS"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/one_way_bar"
        android:layout_width="220dp"
        android:layout_height="42dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_pill_orange"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        app:layout_constraintStart_toStartOf="@id/route_bar"
        app:layout_constraintTop_toBottomOf="@id/route_bar">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/one_way"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_toggle_dot" />
    </LinearLayout>

    <TextView
        android:id="@+id/traveller_bar"
        android:layout_width="220dp"
        android:layout_height="42dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_pill_orange"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:text="@string/one_traveller"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@id/one_way_bar"
        app:layout_constraintTop_toBottomOf="@id/one_way_bar" />

    <ImageView
        android:id="@+id/galaxy"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="26dp"
        android:contentDescription="星球"
        android:scaleType="fitCenter"
        android:src="@drawable/galaxy"
        app:layout_constraintBottom_toTopOf="@id/depart_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/traveller_bar" />

    <ImageView
        android:id="@+id/rocket"
        android:layout_width="30dp"
        android:layout_height="62dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="飞行器"
        android:rotation="-18"
        android:scaleType="fitCenter"
        android:src="@drawable/rocket_icon"
        app:layout_constraintBottom_toBottomOf="@id/galaxy"
        app:layout_constraintEnd_toStartOf="@id/galaxy"
        app:layout_constraintTop_toTopOf="@id/galaxy" />

    <Button
        android:id="@+id/depart_button"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_depart"
        android:backgroundTint="@null"
        android:text="@string/depart"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
